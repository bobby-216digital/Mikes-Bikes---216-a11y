  {%- endif -%}
  {% if template contains 'product' %}
    <link  rel="preload" href="{{ product.featured_image |  img_url: '400x'   }}" as="image"> 
  {% endif %}
     
  {%- render 'seo-title' -%}

  {%- if page_description -%}
