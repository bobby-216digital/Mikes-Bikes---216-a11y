{% comment %}
Rebate Deal

{% for tag in product.tags %}
	{% if tag contains 'rebate-' %}
		{% assign rebate = tag | remove: 'rebate-' | times: 100 %}            		
			<div style="color: red; font-size: 16px; font-weight: 800;">
				Final Price after rebate {{ current_variant.price | minus: rebate | floor | money }} (save {{ rebate | times: 2 | money }})
			</div>
			<div style="color: gray; font-size: 13px; margin-bottom: 10px;">
				Visit <a style="color: gray;" target="_blank" href="https://www.specializedrebates.com">specializedrebates.com</a> to claim your {{ rebate | money }} rebate
			</div>	                	     
	{% endif %}
{% endfor %}

{% endcomment %}
