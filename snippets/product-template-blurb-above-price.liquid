{% comment %}
This code hides deafult Pay with Flex messaging for products that are not tagged
{% endcomment %}

{% unless product.tags contains 'hsaeligible' %}
  <style>
    /* Hide just the badge image */
    img[src*="flex-product-badge"] { display: none !important; }

    /* Hide the modal that follows the image */
    img[src*="flex-product-badge"] + dialog { display: none !important; }

    /* (Optional) if your theme renders a backdrop */
    img[src*="flex-product-badge"] + dialog::backdrop { display: none !important; }

  </style>
{% endunless %}

