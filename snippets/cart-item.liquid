{% comment %} Inventory and Special Order Math {% endcomment %}
{% assign increase_notice = false %}
{% assign contains_so_bike = false %}

{% for item in cart.items %}
  {% comment %} check if the current variant on loop has a metafield of sf_location_inv {% endcomment %}
  {% assign has_metafield = false %}
  {% assign variant = item.variant %}
  {% for check_variant in variant.metafields.sf_location_inv %}
    {% if forloop.length  > 0 %}
      {% assign has_metafield = true %}
    {% endif %}
  {% endfor %}
  
  {% comment %} code to check if the product is a special order {% endcomment %}
  {% assign is_special_order = false %}
  {% assign regular_store_total = 0 %}
  {% assign special_order_total = 0 %}
  {% for field in variant.metafields.sf_location_inv %}
    {% assign store_name = field | first | replace: '_', ' ' %}
    {% assign store_inv = field | last %}
    {% if store_name contains "special" or store_name == "special order" %}
      {% assign special_order_total = special_order_total | plus: store_inv %}
    {% else %}
      {% assign regular_store_total = regular_store_total | plus: store_inv %}
    {% endif %}
  {% endfor %}
  
  {% comment %} if cart contains a special order product {% endcomment %}
  {% if regular_store_total < 1 and special_order_total > 0 %}
    {% assign increase_notice = true %}
  {% endif %}
  
  {% comment %} if cart contains a special order bike {% endcomment %}
  {% if regular_store_total < 1 and special_order_total > 0 and item.product.tags contains 'Bikes' %}
    {% assign contains_so_bike = true %}
  {% endif %}
{% endfor %}


<div class="cart__item" data-key="{{ product.key }}">
  <div class="cart__image">
    {% if product.image != blank %}
      <a href="{{ product.url }}" class="image-wrap">
        {%- render 'image-element',
          img: product,
          alt: product.product.title,
          widths: '180, 360, 540',
          sizes: sizes,
          sizeVariable: sizeVariable,
          fallback: fallback,
        -%}
      </a>
    {% endif %}
  </div>
  <div class="cart__item-details">
    <div class="cart__item-title">
      <a href="{{ product.url }}" class="cart__item-name">
        {{ product.product.title }}
      </a>
      {%- unless product.product.has_only_default_variant -%}
        <div class="cart__item--variants">
          {%- for option in product.options_with_values -%}
            <div><span>{{ option.name }}:</span> {{ option.value }}</div>
          {%- endfor -%}
        </div>
      {%- endunless -%}
      <div class="cart__fee-details" style="margin-top: 6px; font-size: 0.85em; color: #555;">

  {%- comment -%} 1. Check for Line Item Properties (The "Easy" Way) {%- endcomment -%}
  {%- for property in product.properties -%}
    {%- assign first_char = property.first | slice: 0 -%}
    {%- unless property.last == blank or first_char == '_' -%}
      <div class="product-option">
        <strong>{{ property.first }}:</strong> {{ property.last }}
      </div>
    {%- endunless -%}
  {%- endfor -%}

  {%- comment -%} 2. Check for Item Components (The "Developer" Way) {%- endcomment -%}
  {%- if product.item_components.size > 0 -%}
    <div class="components-list" style="margin-top: 4px;">
      <strong>Included Fees:</strong>
      {%- for component in product.item_components -%}
        <div class="component-row" style="display: flex; justify-content: space-between;">
          <span>{{ component.title }}</span>
          {%- if component.price > 0 -%}
            <span>{{ component.price | money }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>
      {%- if product.selling_plan_allocation != empty -%}
        <div class="cart__item--variants">
          {{ product.selling_plan_allocation.selling_plan.name }}
        </div>
      {%- endif -%}
      {%- assign property_size = product.properties | size -%}
      {% if property_size > 0 %}
        {% for p in product.properties %}
          {%- assign first_character_in_key = p.first | truncate: 1, '' -%}
          {% unless p.last == blank or first_character_in_key == '_' %}
            <div class="cart__item--properties">
              <span>{{ p.first }}:</span>
              {% if p.last contains '/uploads/' %}
                <a href="{{ p.last }}">
{% assign file_type = p.last | split: '.' | last | downcase %}
{% assign file_types = 'jpg,jpeg,webp,gif,png,apng,avif,svg,bmp,ico,tiff' | split: ',' %}
{% if file_types contains file_type %}
  <div class="bcpo-cart-file"><img src="{{ p.last }}" style="max-width: 50px; height: auto;"></div>
{% else %}
  <span class="bcpo-cart-file">Uploaded file</span>
{% endif %}
</a>
              {% else %}
                {{ p.last }}
              {% endif %}
            </div>
          {% endunless %}
        {% endfor %}
      {% endif %}

    </div>
    <div class="cart__item-sub">
      <div>
        <div class="js-qty__wrapper">
          <label for="cart_updates_{{ product.key }}" class="hidden-label">{{ 'cart.label.quantity' | t }}</label>
          <input type="text"
            id="cart_updates_{{ product.key }}"
            name="updates[]"
            class="js-qty__num"
            value="{{ product.quantity }}"
            min="0"
            pattern="[0-9]*"
            data-id="{{ product.key }}">
          <button type="button"
            class="js-qty__adjust js-qty__adjust--minus"
            aria-label="{{ 'cart.general.reduce_quantity' | t }}">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-minus" viewBox="0 0 20 20"><path fill="#444" d="M17.543 11.029H2.1A1.032 1.032 0 0 1 1.071 10c0-.566.463-1.029 1.029-1.029h15.443c.566 0 1.029.463 1.029 1.029 0 .566-.463 1.029-1.029 1.029z"/></svg>
              <span class="icon__fallback-text" aria-hidden="true">&minus;</span>
          </button>
          <button type="button"
            class="js-qty__adjust js-qty__adjust--plus"
            aria-label="{{ 'cart.general.increase_quantity' | t }}">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-plus" viewBox="0 0 20 20"><path fill="#444" d="M17.409 8.929h-6.695V2.258c0-.566-.506-1.029-1.071-1.029s-1.071.463-1.071 1.029v6.671H1.967C1.401 8.929.938 9.435.938 10s.463 1.071 1.029 1.071h6.605V17.7c0 .566.506 1.029 1.071 1.029s1.071-.463 1.071-1.029v-6.629h6.695c.566 0 1.029-.506 1.029-1.071s-.463-1.071-1.029-1.071z"/></svg>
              <span class="icon__fallback-text" aria-hidden="true">+</span>
          </button>
        </div>

        <div class="cart__remove">
          <a href="{{ routes.cart_change_url }}?id={{ product.key }}&amp;quantity=0" class="text-link">
            {{ 'cart.general.remove' | t }}
          </a>
        </div>
      </div>

      <div class="cart__item-price-col text-right">
        {% if product.original_price != product.final_price %}
          <span class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
          <small class="cart__price cart__price--strikethrough">
            {{ product.original_price | money }}
          </small>
          <span class="visually-hidden">{{ 'products.general.sale_price' | t }}</span>
          <span class="cart__price cart__discount">
            {{ product.final_price | money }}
          </span>
        {% else %}
          <span class="cart__price">
            {{ product.original_price | money }}
          </span>
        {% endif %}

        {%- if product.line_level_discount_allocations != blank -%}
          {%- for discount_allocation in product.line_level_discount_allocations -%}
            <small class="cart__discount">{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})</small>
          {%- endfor -%}
        {%- endif -%}

        {%- if product.unit_price_measurement -%}
          {%- capture unit_price_base_unit -%}
            <span class="unit-price-base">
              {%- if product.unit_price_measurement -%}
                {%- if product.unit_price_measurement.reference_value != 1 -%}
                  {{ product.unit_price_measurement.reference_value }}
                {%- endif -%}
                {{ product.unit_price_measurement.reference_unit }}
              {%- endif -%}
            </span>
          {%- endcapture -%}

          <div class="product__unit-price">{{ product.unit_price | money }}/{{ unit_price_base_unit }}</div>
        {%- endif -%}
      </div>
                
    </div>

{% if product.title contains "Get Carded" %}
<div style="padding-top: 35px;"><p class="special_message">Your Get Carded Promo Card will be emailed to you on 12/26/2025</p></div>
{% endif %}

    {% if product.product.tags contains 'powermorepromo' %}
         <div style="padding-top: 35px;"><p class="special_message">Register your bike with the <a href="https://www.santacruzbicycles.com/pages/owners-club" style="color: #cd7800; text-decoration: underline;">Santa Cruz Owners Club</a> to redeem your free Bosch Range Extender.</p></div>
    {% endif %}

     {% if product.product.tags contains 'closeout' %}
         <div style="padding-top: 35px; color: red; font-size: 14px;">CLOSEOUT ITEMS ARE FINAL SALE. NO RETURNS.</div>
    {% endif %}

    {% if product.product.tags contains 'hsaeligible' %}
      <div style="padding-top: 20px;">
        <a href="https://mikesbikes.com/pages/hsa-fsa-payments-with-flex"  style="display:inline-block;"></a>
      <img src="https://cdn.shopify.com/s/files/1/0016/3856/3907/files/sticker2-light-b.png?v=1768338889" alt="HSA/FSA Eligible" loading="lazy" style="display:block; width:100%; max-width:160px; height:auto;">
    </div>
    {% endif %}
                
    {% if template == 'cart' %}
      <div class="cart__store-availability">{% render 'store-availability-cart', variant: product.variant, blocks: blocks, special_order_text: special_order_text %} </div>
    {% endif %}
  </div>
</div>