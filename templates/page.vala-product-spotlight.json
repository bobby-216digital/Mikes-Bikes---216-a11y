{"sections":{"shogun-helper":{"type":"shogun-helper","disabled":true,"settings":{}},"slideshow_HRp9Ud":{"type":"slideshow","blocks":{"image_imRXGg":{"type":"image","settings":{"top_subheading":"","title":"THE VALA LINEUP","title_size":74,"subheading":"Light, versatile, or value-driven. Which one is right for you?","link":"","link_text":"","link_2":"","link_text_2":"","color_accent":"#00337f","text_align":"vertical-center horizontal-center","image":"shopify:\/\/shop_images\/SantaCruz-PLP-Find-Your-Vala_Desktop_2000x_eeaef21c-e629-4953-9e22-478ec40323b9.jpg","image_mobile":"shopify:\/\/shop_images\/SantaCruz-PLP-Find-Your-Vala_Mobile_1080x_369cfaff-a0c2-425c-90e8-ede3c2461a00.jpg","parallax_direction":"top","overlay_opacity":0}}},"block_order":["image_imRXGg"],"custom_css":[],"name":"t:sections.slideshow.presets.hero_optional_slideshow.name","settings":{"section_height":"natural","mobile_height":"auto","parallax":false,"style":"bars","autoplay":true,"autoplay_speed":5,"lazyload_images":false}},"main":{"type":"main-page","disabled":true,"custom_css":[],"settings":{}},"rich_text_BnTwth":{"type":"rich-text","blocks":{"heading_3qzBzV":{"type":"heading","settings":{"title":"One Platform. Three Ways to Ride."}},"page_HzRnLt":{"type":"page","disabled":true,"settings":{"page_text":"find-your-vala"}},"text_7E3XtX":{"type":"text","settings":{"enlarge_text":false,"text":"<p>The Santa Cruz Vala platform has always been about the way it rides.<\/p><p>Now available in three distinct builds, it gives riders a clearer way to choose—whether that means a lighter feel, all-around versatility, or a more accessible entry into eMTB. The result is a lineup tuned to how you ride, without changing what makes Vala so capable.<\/p>"}},"button_jBVnhR":{"type":"button","settings":{"link":"#All-Builds","link_text":"FIND YOUR VALA →"}}},"block_order":["heading_3qzBzV","page_HzRnLt","text_7E3XtX","button_jBVnhR"],"custom_css":[],"name":"t:sections.rich-text.presets.rich_text.name","settings":{"align