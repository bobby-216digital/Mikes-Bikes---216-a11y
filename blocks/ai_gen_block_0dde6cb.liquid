{% doc %}
  @prompt
    Create text columns with icons. Option to upload your own icon.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-icon-columns-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-icon-columns__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-icon-columns__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-icon-columns__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-icon-columns__column-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.text_alignment }};
  }

  .ai-icon-columns__icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-icon-columns__icon-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-icon-columns__icon-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  .ai-icon-columns__icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-icon-columns__icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    fill: #cccccc;
  }

  .ai-icon-columns__title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.title_spacing }}px;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
  }

  .ai-icon-columns__text-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  @media screen and (max-width: 989px) {
    .ai-icon-columns__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-icon-columns__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-icon-columns__icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-icon-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-icon-columns__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-icon-columns__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-icon-columns__grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign column_enabled_key = 'column_' | append: i | append: '_enabled'
          assign column_icon_key = 'column_' | append: i | append: '_icon'
          assign column_title_key = 'column_' | append: i | append: '_title'
          assign column_text_key = 'column_' | append: i | append: '_text'

          assign column_enabled = block.settings[column_enabled_key]
          assign column_icon = block.settings[column_icon_key]
          assign column_title = block.settings[column_title_key]
          assign column_text = block.settings[column_text_key]
        %}

        {% if column_enabled %}
          <div class="ai-icon-columns__column-{{ ai_gen_id }}">
            <div class="ai-icon-columns__icon-wrapper-{{ ai_gen_id }}">
              {% if column_icon != blank %}
                <img
                  src="{{ column_icon | image_url: width: 200 }}"
                  alt="{{ column_title | escape }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% else %}
                <div class="ai-icon-columns__icon-placeholder-{{ ai_gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                  </svg>
                </div>
              {% endif %}
            </div>

            {% if column_title != blank %}
              <h3 class="ai-icon-columns__title-{{ ai_gen_id }}">{{ column_title }}</h3>
            {% endif %}

            {% if column_text != blank %}
              <div class="ai-icon-columns__text-{{ ai_gen_id }}">{{ column_text }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

