{% doc %}
  @prompt
    A 4 column model that support images with headlines and subheaders. Images should stack on mobile., This is great. Can we prioritize the text above the image?
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-four-column-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-four-column__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-four-column__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-four-column__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-four-column__text-wrapper-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.text_spacing }}px;
  }

  .ai-four-column__headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    color: {{ block.settings.headline_color }};
    margin: 0 0 {{ block.settings.headline_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-four-column__subheader-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheader_size }}px;
    color: {{ block.settings.subheader_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-four-column__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-four-column__image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-four-column__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-four-column__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-four-column__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-four-column__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-four-column__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.9 }}px;
    }

    .ai-four-column__subheader-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheader_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<four-column-block-{{ ai_gen_id }} class="ai-four-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-four-column__container-{{ ai_gen_id }}">
    <div class="ai-four-column__grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign headline_key = 'headline_' | append: i
          assign subheader_key = 'subheader_' | append: i
          
          assign image = block.settings[image_key]
          assign headline = block.settings[headline_key]
          assign subheader = block.settings[subheader_key]
        %}
        
        <div class="ai-four-column__item-{{ ai_gen_id }}">
          <div class="ai-four-column__text-wrapper-{{ ai_gen_id }}">
            {% if headline != blank %}
              <h3 class="ai-four-column__headline-{{ ai_gen_id }}">{{ headline }}</h3>
            {% endif %}
            
            {% if subheader != blank %}
              <p class="ai-four-column__subheader-{{ ai_gen_id }}">{{ subheader }}</p>
            {% endif %}
          </div>

          <div class="ai-four-column__image-wrapper-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 600 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {% else %}
              <div class="ai-four-column__image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</four-column-block-{{ ai_gen_id }}>

<script>
  (function() {
    class FourColumnBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    
    customElements.define('four-column-block-{{ ai_gen_id }}', FourColumnBlock{{ ai_gen_id }});
  })();
</script>

