{% doc %}
  @prompt
    A 3 column model that support images with headlines and subheaders. Images should stack on mobile. Container width should be adjustable and text should be positions above the image., This is a great. I just need the ability to adjust the background color.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-column-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-three-column-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-three-column-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-three-column-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_spacing }}px;
  }

  .ai-three-column-text-wrapper-{{ ai_gen_id }} {
    order: 1;
  }

  .ai-three-column-image-wrapper-{{ ai_gen_id }} {
    order: 2;
    width: 100%;
    position: relative;
  }

  .ai-three-column-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-three-column-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-three-column-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-three-column-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    color: {{ block.settings.headline_color }};
    margin: 0;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-three-column-subheader-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheader_size }}px;
    color: {{ block.settings.subheader_color }};
    margin: 0;
    text-align: {{ block.settings.text_alignment }};
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-three-column-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }
  }
{% endstyle %}

<three-column-block-{{ ai_gen_id }}
  class="ai-three-column-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-three-column-container-{{ ai_gen_id }}">
    <div class="ai-three-column-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'column_' | append: i | append: '_image'
          assign headline_key = 'column_' | append: i | append: '_headline'
          assign subheader_key = 'column_' | append: i | append: '_subheader'

          assign column_image = block.settings[image_key]
          assign column_headline = block.settings[headline_key]
          assign column_subheader = block.settings[subheader_key]
        %}

        <div class="ai-three-column-item-{{ ai_gen_id }}">
          <div class="ai-three-column-text-wrapper-{{ ai_gen_id }}">
            {% if column_headline != blank %}
              <h3 class="ai-three-column-headline-{{ ai_gen_id }}">{{ column_headline }}</h3>
            {% endif %}

            {% if column_subheader != blank %}
              <p class="ai-three-column-subheader-{{ ai_gen_id }}">{{ column_subheader }}</p>
            {% endif %}
          </div>

          <div class="ai-three-column-image-wrapper-{{ ai_gen_id }}">
            {% if column_image %}
              <img
                src="{{ column_image | image_url: width: 800 }}"
                alt="{{ column_image.alt | escape }}"
                loading="lazy"
                width="{{ column_image.width }}"
                height="{{ column_image.height }}"
                class="ai-three-column-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-three-column-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</three-column-block-{{ ai_gen_id }}>

<script>
  (function() {
    class ThreeColumnBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('three-column-block-{{ ai_gen_id }}', ThreeColumnBlock{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Three column layout",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "text_spacing",
      "label": "Text spacing",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "4/3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "16/9",
          "label": "Wide (16:9)"
        },
        {
          "value": "3/4",
          "label": "Portrait (3:4)"
        }
      ],
      "default": "4/3"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "headline_size",
      "label": "Headline size",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Headline color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "subheader_size",
      "label": "Subheader size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "subheader_color",
      "label": "Subheader color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "image_picker",
      "id": "column_1_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "column_1_headline",
      "label": "Headline",
      "default": "Feature one"
    },
    {
      "type": "textarea",
      "id": "column_1_subheader",
      "label": "Subheader",
      "default": "Share details about your product or service"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "image_picker",
      "id": "column_2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "column_2_headline",
      "label": "Headline",
      "default": "Feature two"
    },
    {
      "type": "textarea",
      "id": "column_2_subheader",
      "label": "Subheader",
      "default": "Share details about your product or service"
    },
    {
      "type": "header",
      "content": "Column 3"
    },
    {
      "type": "image_picker",
      "id": "column_3_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "column_3_headline",
      "label": "Headline",
      "default": "Feature three"
    },
    {
      "type": "textarea",
      "id": "column_3_subheader",
      "label": "Subheader",
      "default": "Share details about your product or service"
    }
  ],
  "presets": [
    {
      "name": "Three column layout"
    }
  ]
}
{% endschema %}
