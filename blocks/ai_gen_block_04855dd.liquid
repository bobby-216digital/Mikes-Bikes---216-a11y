{% doc %}
  @prompt
    I would like category slider for up 8 collections. Each collection should have an adjustable header with bold text, an option CTA, and the ability to add a custom image. I would like adjustable features for each collection and all text., No box shadows. Ability to go full width. No animation on hover. Add slide arrows. Add ability to adjust alignment for text. , It should be a slider on mobile. Increase range for image height and width. And ability to select how many collections display in each window on desktop. A portion of the trailing collection image should appear on mobile. Images should link to assigned collections. , It should be a slider on mobile. Navigation buttons should be optional and beneath the collection. Add a custom CTA for each collection. The trailing image features needs some work on mobile., It should be a slider on mobile. The navigation buttons should be be beneath the collection on desktop and mobile., Replace custom description with custom subheading. The collection should not pull in the collection description when assigned., Should be a slider on mobile. Everything else is great. Make sure the image links to the assigned collection., create a custom sub title field for the collection., The custom subtitle field should be above the custom title, CTAs should be more customizable.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-slider-{{ ai_gen_id }} {
    width: 100%;
    {% if block.settings.full_width %}
      margin-left: calc(-50vw + 50%);
      margin-right: calc(-50vw + 50%);
      width: 100vw;
    {% endif %}
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-collection-slider-container-{{ ai_gen_id }} {
    {% unless block.settings.full_width %}
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    {% else %}
      padding: 0 20px;
    {% endunless %}
    position: relative;
  }

  .ai-collection-slider-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-collection-slider-title-{{ ai_gen_id }} {
    font-family: {{ settings.type_header_font_family.family }}, {{ settings.type_header_font_family.fallback_families }};
    font-weight: {{ settings.type_header_font_family.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    line-height: 1.2;
    {% if settings.type_header_capitalize %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-collection-slider-subtitle-{{ ai_gen_id }} {
    font-family: {{ settings.type_base_font_family.family }}, {{ settings.type_base_font_family.fallback_families }};
    font-weight: {{ settings.type_base_font_family.weight }};
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 20px;
    line-height: 1.4;
  }

  .ai-collection-slider-cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.main_cta_padding_vertical }}px {{ block.settings.main_cta_padding_horizontal }}px;
    background-color: {{ block.settings.cta_bg_color }};
    color: {{ block.settings.cta_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.main_cta_border_radius }}px;
    font-family: {{ settings.type_base_font_family.family }}, {{ settings.type_base_font_family.fallback_families }};
    font-weight: {{ settings.type_base_font_family.weight }};
    font-size: {{ block.settings.main_cta_font_size }}px;
    transition: all 0.3s ease;
    border: {{ block.settings.main_cta_border_width }}px solid {{ block.settings.main_cta_border_color }};
    {% if block.settings.main_cta_uppercase %}
      text-transform: uppercase;
    {% endif %}
    {% if block.settings.main_cta_bold %}
      font-weight: bold;
    {% endif %}
  }

  .ai-collection-slider-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_bg_color }};
    color: {{ block.settings.cta_hover_text_color }};
    border-color: {{ block.settings.main_cta_hover_border_color }};
    transform: translateY({{ block.settings.main_cta_hover_transform }}px);
  }

  .ai-collection-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-collection-slider-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.3s ease;
    gap: 20px;
  }

  .ai-collection-slide-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: calc((100% - ({{ block.settings.desktop_columns | minus: 1 }} * 20px)) / {{ block.settings.desktop_columns }});
    position: relative;
  }

  .ai-collection-slide-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: block;
    text-decoration: none;
  }

  .ai-collection-slide-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-collection-slide-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-slide-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.5;
  }

  .ai-collection-slide-content-{{ ai_gen_id }} {
    padding: 20px 0;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-collection-slide-subtitle-{{ ai_gen_id }} {
    font-family: {{ settings.type_base_font_family.family }}, {{ settings.type_base_font_family.fallback_families }};
    font-weight: {{ settings.type_base_font_family.weight }};
    font-size: {{ block.settings.collection_subtitle_size }}px;
    color: {{ block.settings.collection_subtitle_color }};
    margin: 0 0 8px;
    line-height: 1.4;
  }

  .ai-collection-slide-title-{{ ai_gen_id }} {
    font-family: {{ settings.type_header_font_family.family }}, {{ settings.type_header_font_family.fallback_families }};
    font-weight: {{ settings.type_header_font_family.weight }};
    font-size: {{ block.settings.collection_title_size }}px;
    color: {{ block.settings.collection_title_color }};
    margin: 0 0 8px;
    line-height: 1.3;
    {% if settings.type_header_capitalize %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-collection-slide-subheading-{{ ai_gen_id }} {
    font-family: {{ settings.type_base_font_family.family }}, {{ settings.type_base_font_family.fallback_families }};
    font-weight: {{ settings.type_base_font_family.weight }};
    font-size: {{ block.settings.collection_subheading_size }}px;
    color: {{ block.settings.collection_subheading_color }};
    margin: 0 0 12px;
    line-height: 1.4;
  }

  .ai-collection-slide-cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.collection_cta_padding_vertical }}px {{ block.settings.collection_cta_padding_horizontal }}px;
    background-color: {{ block.settings.collection_cta_bg_color }};
    color: {{ block.settings.collection_cta_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.collection_cta_border_radius }}px;
    font-family: {{ settings.type_base_font_family.family }}, {{ settings.type_base_font_family.fallback_families }};
    font-weight: {{ settings.type_base_font_family.weight }};
    font-size: {{ block.settings.collection_cta_font_size }}px;
    transition: all 0.3s ease;
    border: {{ block.settings.collection_cta_border_width }}px solid {{ block.settings.collection_cta_border_color }};
    {% if block.settings.collection_cta_uppercase %}
      text-transform: uppercase;
    {% endif %}
    {% if block.settings.collection_cta_bold %}
      font-weight: bold;
    {% endif %}
  }

  .ai-collection-slide-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.collection_cta_hover_bg_color }};
    color: {{ block.settings.collection_cta_hover_text_color }};
    border-color: {{ block.settings.collection_cta_hover_border_color }};
    transform: translateY({{ block.settings.collection_cta_hover_transform }}px);
  }

  .ai-collection-slider-nav-{{ ai_gen_id }} {
    background-color: {{ block.settings.arrow_bg_color }};
    color: {{ block.settings.arrow_color }};
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
    margin: 0 10px;
  }

  .ai-collection-slider-nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_bg_color }};
    color: {{ block.settings.arrow_hover_color }};
  }

  .ai-collection-slider-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-collection-slider-nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-collection-slider-navigation-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 30px;
    {% unless block.settings.show_navigation %}
      display: none;
    {% endunless %}
  }

  @media screen and (max-width: 768px) {
    .ai-collection-slider-wrapper-{{ ai_gen_id }} {
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .ai-collection-slider-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-collection-slider-track-{{ ai_gen_id }} {
      gap: 15px;
      padding-right: 20px;
    }

    .ai-collection-slide-{{ ai_gen_id }} {
      width: 280px;
      flex-shrink: 0;
    }

    .ai-collection-slide-image-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_image_height }}px;
    }

    .ai-collection-slider-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-collection-slider-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .ai-collection-slide-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.collection_title_size | times: 0.9 }}px;
    }

    .ai-collection-slide-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.collection_subtitle_size | times: 0.9 }}px;
    }

    .ai-collection-slide-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.collection_subheading_size | times: 0.9 }}px;
    }

    .ai-collection-slider-cta-{{ ai_gen_id }} {
      font-size: {{ block.settings.main_cta_font_size | times: 0.9 }}px;
      padding: {{ block.settings.main_cta_padding_vertical | times: 0.8 }}px {{ block.settings.main_cta_padding_horizontal | times: 0.8 }}px;
    }

    .ai-collection-slide-cta-{{ ai_gen_id }} {
      font-size: {{ block.settings.collection_cta_font_size | times: 0.9 }}px;
      padding: {{ block.settings.collection_cta_padding_vertical | times: 0.8 }}px {{ block.settings.collection_cta_padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}

<collection-slider-{{ ai_gen_id }}
  class="ai-collection-slider-{{ ai_gen_id }}"
  data-desktop-columns="{{ block.settings.desktop_columns }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-slider-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank or block.settings.cta_text != blank %}
      <div class="ai-collection-slider-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-collection-slider-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <div class="ai-collection-slider-subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}
        {% if block.settings.cta_text != blank and block.settings.cta_url != blank %}
          <a href="{{ block.settings.cta_url }}" class="ai-collection-slider-cta-{{ ai_gen_id }}">
            {{ block.settings.cta_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-collection-slider-wrapper-{{ ai_gen_id }}">
      <div class="ai-collection-slider-track-{{ ai_gen_id }}" data-track>
        {% for i in (1..8) %}
          {% liquid
            assign collection_key = 'collection_' | append: i
            assign custom_image_key = 'custom_image_' | append: i
            assign custom_title_key = 'custom_title_' | append: i
            assign custom_subtitle_key = 'custom_subtitle_' | append: i
            assign custom_subheading_key = 'custom_subheading_' | append: i
            assign custom_cta_text_key = 'custom_cta_text_' | append: i
            assign custom_cta_url_key = 'custom_cta_url_' | append: i
            assign enabled_key = 'enable_collection_' | append: i

            assign collection = block.settings[collection_key]
            assign custom_image = block.settings[custom_image_key]
            assign custom_title = block.settings[custom_title_key]
            assign custom_subtitle = block.settings[custom_subtitle_key]
            assign custom_subheading = block.settings[custom_subheading_key]
            assign custom_cta_text = block.settings[custom_cta_text_key]
            assign custom_cta_url = block.settings[custom_cta_url_key]
            assign enabled = block.settings[enabled_key]
          %}

          {% if enabled %}
            <div class="ai-collection-slide-{{ ai_gen_id }}">
              {% if collection != blank %}
                <a href="{{ collection.url }}" class="ai-collection-slide-image-{{ ai_gen_id }}">
              {% else %}
                <div class="ai-collection-slide-image-{{ ai_gen_id }}">
              {% endif %}
                {% if custom_image != blank %}
                  <img
                    src="{{ custom_image | image_url: width: 800 }}"
                    alt="{{ custom_image.alt | escape }}"
                    loading="lazy"
                    width="{{ custom_image.width }}"
                    height="{{ custom_image.height }}"
                  >
                {% elsif collection != blank and collection.featured_image != blank %}
                  <img
                    src="{{ collection.featured_image | image_url: width: 800 }}"
                    alt="{{ collection.featured_image.alt | escape }}"
                    loading="lazy"
                    width="{{ collection.featured_image.width }}"
                    height="{{ collection.featured_image.height }}"
                  >
                {% else %}
                  <div class="ai-collection-slide-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              {% if collection != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}

              <div class="ai-collection-slide-content-{{ ai_gen_id }}">
                {% if custom_subtitle != blank %}
                  <div class="ai-collection-slide-subtitle-{{ ai_gen_id }}">
                    {{ custom_subtitle }}
                  </div>
                {% endif %}
                
                <h3 class="ai-collection-slide-title-{{ ai_gen_id }}">
                  {% if custom_title != blank %}
                    {{ custom_title }}
                  {% elsif collection != blank %}
                    {{ collection.title }}
                  {% else %}
                    Collection {{ i }}
                  {% endif %}
                </h3>
                
                {% if custom_subheading != blank %}
                  <div class="ai-collection-slide-subheading-{{ ai_gen_id }}">
                    {{ custom_subheading }}
                  </div>
                {% endif %}
                
                {% if custom_cta_text != blank and custom_cta_url != blank %}
                  <a href="{{ custom_cta_url }}" class="ai-collection-slide-cta-{{ ai_gen_id }}">
                    {{ custom_cta_text }}
                  </a>
                {% elsif collection != blank and custom_cta_text != blank %}
                  <a href="{{ collection.url }}" class="ai-collection-slide-cta-{{ ai_gen_id }}">
                    {{ custom_cta_text }}
                  </a>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if block.settings.show_navigation %}
      <div class="ai-collection-slider-navigation-{{ ai_gen_id }}">
        <button
          class="ai-collection-slider-nav-{{ ai_gen_id }} ai-collection-slider-nav-prev-{{ ai_gen_id }}"
          data-prev
          aria-label="Previous collections"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15,18 9,12 15,6"></polyline>
          </svg>
        </button>

        <button
          class="ai-collection-slider-nav-{{ ai_gen_id }} ai-collection-slider-nav-next-{{ ai_gen_id }}"
          data-next
          aria-label="Next collections"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9,18 15,12 9,6"></polyline>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>
</collection-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.isTransitioning = false;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.prevButtons = this.querySelectorAll('[data-prev]');
        this.nextButtons = this.querySelectorAll('[data-next]');
        this.slides = this.querySelectorAll('.ai-collection-slide-{{ ai_gen_id }}');
        this.desktopColumns = parseInt(this.dataset.desktopColumns);

        this.setupEventListeners();
        this.updateNavigation();
        this.handleResize();

        window.addEventListener('resize', () => this.handleResize());
      }

      setupEventListeners() {
        this.prevButtons.forEach(button => {
          button.addEventListener('click', () => this.goToPrevious());
        });
        
        this.nextButtons.forEach(button => {
          button.addEventListener('click', () => this.goToNext());
        });
      }

      handleResize() {
        this.isMobile = window.innerWidth <= 768;
        if (!this.isMobile) {
          this.updateSlidePositions();
        }
        this.updateNavigation();
      }

      updateSlidePositions() {
        if (!this.isMobile) {
          const slideWidth = this.slides[0]?.offsetWidth || 0;
          const gap = 20;
          this.track.style.transform = `translateX(-${this.currentIndex * (slideWidth + gap)}px)`;
        }
      }

      goToPrevious() {
        if (this.isMobile || this.isTransitioning || this.currentIndex === 0) return;
        this.isTransitioning = true;
        this.currentIndex--;
        this.updateSlidePositions();
        this.updateNavigation();
        setTimeout(() => {
          this.isTransitioning = false;
        }, 300);
      }

      goToNext() {
        if (this.isMobile) return;
        
        const maxIndex = Math.max(0, this.slides.length - this.desktopColumns);
        
        if (this.isTransitioning || this.currentIndex >= maxIndex) return;
        this.isTransitioning = true;
        this.currentIndex++;
        this.updateSlidePositions();
        this.updateNavigation();
        setTimeout(() => {
          this.isTransitioning = false;
        }, 300);
      }

      updateNavigation() {
        if (this.isMobile) {
          this.prevButtons.forEach(button => {
            button.style.display = 'none';
          });
          this.nextButtons.forEach(button => {
            button.style.display = 'none';
          });
          return;
        }

        const maxIndex = Math.max(0, this.slides.length - this.desktopColumns);

        this.prevButtons.forEach(button => {
          button.disabled = this.currentIndex === 0;
          button.style.display = 'flex';
        });
        
        this.nextButtons.forEach(button => {
          button.disabled = this.currentIndex >= maxIndex;
          button.style.display = 'flex';
        });
      }
    }

    customElements.define('collection-slider-{{ ai_gen_id }}', CollectionSlider{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Collection slider",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 50
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collections"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 36
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subheading size",
      "default": 16
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Main CTA button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button link"
    },
    {
      "type": "range",
      "id": "main_cta_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "main_cta_padding_vertical",
      "min": 5,
      "max": 25,
      "step": 1,
      "unit": "px",
      "label": "Vertical padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "main_cta_padding_horizontal",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "main_cta_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 6
    },
    {
      "type": "range",
      "id": "main_cta_border_width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 0
    },
