{% doc %}
  @prompt
    Build a “text columns with images" section that lets merchants feature a row of subcollections (up to 8) with custom images and custom image links.
    
    Core requirements
    
    Each slide = image + title + optional subtitle/CTA.
    
    Merchant can override the collection image with a custom image and override the link with a custom URL (not required to point to the collection).
    
    Max rendered image dimension: 600px on the longest side (never exceed 600px even on desktop; scale responsively below that)., Add the ability to select how many columns display on desktop and mobile.
    
    Add customization options for padding., Section should include a heading
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-columns-{{ ai_gen_id }} {
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: 20px;
    padding-right: 20px;
  }

  .ai-text-columns-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-text-columns-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.heading_color }};
  }

  .ai-text-columns-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-text-column-item-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-text-column-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .ai-text-column-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    margin-bottom: {{ block.settings.image_spacing }}px;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-text-column-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    max-width: 600px;
    margin: 0 auto;
  }

  .ai-text-column-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 600px;
    margin: 0 auto;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-text-column-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-text-column-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    color: {{ block.settings.title_color }};
  }

  .ai-text-column-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
    color: {{ block.settings.subtitle_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-text-columns-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
      margin-bottom: {{ block.settings.heading_spacing | times: 0.7 }}px;
    }

    .ai-text-columns-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.column_gap | times: 0.7 }}px;
    }

    .ai-text-column-image-wrapper-{{ ai_gen_id }} {
      margin-bottom: {{ block.settings.image_spacing | times: 0.7 }}px;
    }

    .ai-text-column-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
      margin-bottom: {{ block.settings.title_spacing | times: 0.7 }}px;
    }

    .ai-text-column-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-text-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-text-columns-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-text-columns-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-text-columns-grid-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign custom_image_key = 'custom_image_' | append: i
          assign custom_link_key = 'custom_link_' | append: i
          assign title_key = 'title_' | append: i
          assign subtitle_key = 'subtitle_' | append: i

          assign collection = block.settings[collection_key]
          assign custom_image = block.settings[custom_image_key]
          assign custom_link = block.settings[custom_link_key]
          assign title = block.settings[title_key]
          assign subtitle = block.settings[subtitle_key]

          if custom_image != blank
            assign display_image = custom_image
          elsif collection != blank and collection.image != blank
            assign display_image = collection.image
          else
            assign display_image = blank
          endif

          if custom_link != blank
            assign link_url = custom_link
          elsif collection != blank
            assign link_url = collection.url
          else
            assign link_url = blank
          endif

          if title != blank
            assign display_title = title
          elsif collection != blank
            assign display_title = collection.title
          else
            assign display_title = blank
          endif
        %}

        {% if collection != blank or custom_image != blank or title != blank %}
          <div class="ai-text-column-item-{{ ai_gen_id }}">
            {% if link_url != blank %}
              <a href="{{ link_url }}" class="ai-text-column-link-{{ ai_gen_id }}">
            {% endif %}

            <div class="ai-text-column-image-wrapper-{{ ai_gen_id }}">
              {% if display_image != blank %}
                <img
                  src="{{ display_image | image_url: width: 600 }}"
                  alt="{{ display_image.alt | default: display_title | escape }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | divided_by: display_image.aspect_ratio | round }}"
                  class="ai-text-column-image-{{ ai_gen_id }}"
                  style="max-width: 600px;"
                >
              {% else %}
                <div class="ai-text-column-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if display_title != blank %}
              <h3 class="ai-text-column-title-{{ ai_gen_id }}">{{ display_title }}</h3>
            {% endif %}

            {% if subtitle != blank %}
              <p class="ai-text-column-subtitle-{{ ai_gen_id }}">{{ subtitle }}</p>
            {% endif %}

            {% if link_url != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

